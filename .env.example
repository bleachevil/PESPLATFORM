# Local Postgres (docker compose) or Cloud SQL.
# Leave unset to keep using data/pesdata.sqlite on your PC.

# DATABASE_URL=postgresql://pesdata:pesdata@localhost:5432/pesdata

# Cloud Run + Cloud SQL (unix socket inside Cloud Run):
# CLOUD_SQL_CONNECTION_NAME=footballplatform:REGION:INSTANCE_NAME
# DB_USER=pesdata
# DB_PASSWORD=
# DB_NAME=pesdata
# DATABASE_URL=postgresql://pesdata:PASSWORD@/pesdata?host=/cloudsql/footballplatform:REGION:INSTANCE_NAME
